{
  "configurations" : [
    {
      "id" : "FE9CF113-A448-40F2-B794-93ECE7E8B54D",
      "name" : "Address Sanitizer",
      "options" : {
        "addressSanitizer" : {
          "detectStackUseAfterReturn" : true,
          "enabled" : true
        },
        "mallocScribbleEnabled" : true
      }
    },
    {
      "id" : "CB63CE15-7691-45C1-8034-9CF6B4201289",
      "name" : "Thread Sanitizer",
      "options" : {
        "threadSanitizerEnabled" : true
      }
    }
  ],
  "defaultOptions" : {
    "mainThreadCheckerDetectionPolicy" : {
      "severity" : "failure"
    },
    "nsZombieEnabled" : true,
    "performanceAntipatternCheckerEnabled" : true,
    "runtimeIssueDetection" : {
      "severity" : "failure"
    },
    "testExecutionOrdering" : "random",
    "threadPerformanceCheckerRuntimeIssueDetection" : {
      "severity" : "failure"
    },
    "undefinedBehaviorSanitizerEnabled" : true
  },
  "testTargets" : [
    {
      "target" : {
        "containerPath" : "container:",
        "identifier" : "ReasyncTests",
        "name" : "ReasyncTests"
      }
    }
  ],
  "version" : 1
}
